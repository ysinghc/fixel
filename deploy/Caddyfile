fixel.ysinghc.in {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}
	request_body {
		max_size 64KB
	}
	# Server-sent events must not be buffered; flush_interval -1 streams them as they come.
	reverse_proxy fixel:8765 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}
}
